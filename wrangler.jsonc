{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "vyntro",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "."
  },
  "durable_objects": {
    "bindings": [
      { "name": "UNO_ROOM_DO", "class_name": "UnoRoom" },
      { "name": "VYNTRO_PROFILE_DO", "class_name": "VyntroProfile" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UnoRoom", "VyntroProfile"] }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}
